# Database
DATABASE_URL=sqlite:///./data/appdiscovery.db
# For PostgreSQL: postgresql://user:pass@localhost/appdiscovery

# Cache settings
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=86400

# Rate limiting
RATE_LIMIT_REQUESTS_PER_SECOND=2.0
RATE_LIMIT_BURST=5

# Google Play (disabled by default; requires compliance_ok=true in CLI)
GP_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# User agent for HTTP requests
USER_AGENT=AppDiscovery/0.1 (Research; +https://github.com/yourusername/appdiscovery)

# Translation providers (for future use)
# DEEPL_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# Testing
RUN_SMOKE_TESTS=false
